{
  "name": "unisites-base",
  "version": "0.9.0",
  "description": "Sign-in and mail for a Unisites project's own Worker and D1 (unisites ADR 0021, 0022).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./smtp": {
      "types": "./dist/smtp.d.ts",
      "import": "./dist/smtp.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    },
    "./gotrue": {
      "types": "./dist/gotrue.d.ts",
      "import": "./dist/gotrue.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "bin"
  ],
  "bin": {
    "unisites-base": "bin/unisites-base.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run && npm run build",
    "test": "vitest run",
    "migrations": "node --experimental-strip-types scripts/migrations.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@electric-sql/pglite": "0.5.10",
    "@supabase/supabase-js": "2.108.2",
    "@types/node": "^24",
    "typescript": "^5.9",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22.5"
  }
}
